# wc-web environment (Appendix D.1) — copy to .env.local for local dev.
# Auth mode XOR: exactly one identity path is active at runtime.
#   demo  → standalone demo identity (X-Demo-Employee-Id), DEMO_AUTH_ENABLED gated server-side
#   auth0 → OAuth2 / OIDC bearer-token path
# Auth wiring itself is OUT OF SCOPE for the styling-foundation slice (lands Phase 9.1/9.3);
# this stub documents the contract only.
VITE_AUTH_MODE=demo

# Base URL for the wc-api backend.
VITE_API_BASE_URL=http://localhost:8080
