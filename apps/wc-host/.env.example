# wc-host (Module Federation HOST) environment — copy to .env.local for local dev.
#
# The host loads the wc_web remote and authenticates against the SAME Auth0 tenant
# as the deployed Weekly Commit app, so the embedded remote calls the live API.

# ── Federation remote ────────────────────────────────────────────────────────
# remoteEntry.js URL for the wc_web remote. Read by vite.config.ts at config/build
# time (Node process.env). Point at wherever the remote dist is served.
#   local: build the remote (apps/wc-web: yarn build:remote) + serve dist/ on :5174
VITE_WC_REMOTE_URL=http://localhost:5174/assets/remoteEntry.js

# ── Auth0 (host owns the OAuth login; passes getAccessToken to the remote) ────
# Use the SAME tenant/client/audience as the deployed app. The SPA's redirect_uri
# is derived at runtime as <origin>/callback (no hardcode) — add it (+ <origin> as
# a Web Origin / Logout URL) to the Auth0 SPA application's allow-lists.
VITE_AUTH0_DOMAIN=dev-pw0um8pz8cgr31eo.us.auth0.com
VITE_AUTH0_CLIENT_ID=psB6r4UN0AgRLXLxmp974lieHgOvN2sI
VITE_AUTH0_AUDIENCE=https://api.wc.st6weeklycommit.com

# NOTE: VITE_AUTH_MODE and VITE_API_BASE_URL are baked into the REMOTE at the
# remote's build time (apps/wc-web), NOT here — the host does not call the API.
# Build the remote with:
#   VITE_AUTH_MODE=auth0 VITE_API_BASE_URL=https://api.wc.st6weeklycommit.com
