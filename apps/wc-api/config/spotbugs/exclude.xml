<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter for wc-api (task 0.2).

  Lombok-generated members are skipped automatically by SpotBugs because lombok.config sets
  `lombok.addLombokGeneratedAnnotation=true` (SpotBugs ignores @Generated-annotated code). The
  skeleton uses no Lombok yet, so this filter is intentionally minimal; real exclusions accrete
  as domain code lands in 0.3+.
-->
<FindBugsFilter>
  <!--
    Migration/Testcontainers harnesses build SQL/DDL-validation statements from test-controlled
    values (UUIDs, enum names, hardcoded literals) — never untrusted input. Suppress the SQL
    string-concatenation pattern there only; production code is unaffected.
  -->
  <Match>
    <Class name="~com\.st6\.wc\.migration\..*"/>
    <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
  </Match>
</FindBugsFilter>
